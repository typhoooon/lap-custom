{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lap Custom",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ]
  },
  "bundle": {
    "windows": {
      "wix": {
        "fragmentPaths": [
          "windows/vc-runtime.wxs"
        ],
        "componentGroupRefs": [
          "LapVcRuntimeCheck"
        ],
        "version": "0.3.3.4"
      }
    },
    "resources": {
      "resources/models/*": "models",
      "resources/ffmpeg/*": "ffmpeg",
      "../THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt"
    }
  }
}
